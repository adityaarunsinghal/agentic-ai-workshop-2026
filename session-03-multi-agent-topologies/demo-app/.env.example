# Private local inference. Keep your key out of source and uploads.
OPENROUTER_API_KEY=
# Empty values use these built-in defaults:
# chat: openai/gpt-6-luna; decisions: typesafe/jev-1.13
# app allowance: 3 USD; request reservation: 0.05 USD; timeout: 360000 ms
# generative output: 32768 tokens, bounded by the selected workshop profile
OPENROUTER_MODEL=
OPENROUTER_DECISION_MODEL=
SESSION2_MAX_COST_USD=
SESSION2_MAX_REQUEST_COST_USD=
SESSION2_MODEL_TIMEOUT_MS=
SESSION2_MAX_OUTPUT_TOKENS=
# Optional independent local state and downloads for a comparison.
# SESSION2_STATE_FILE=.local/comparison/issue.json
# SESSION2_EXPORTS_DIRECTORY=.local/comparison/exports

# Alternatively use the workshop development gateway and scoped token.
WORKSHOP_DEVELOPMENT_URL=https://nyu-workshop.adityasinghal.com/api/development
WORKSHOP_DEVELOPMENT_TOKEN=
PORT=8088
