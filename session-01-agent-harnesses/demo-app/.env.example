# npm run dev:development uses the workshop connection and selected funding.
# Use the development gateway URL ending in /api/development.
WORKSHOP_DEVELOPMENT_URL=
WORKSHOP_DEVELOPMENT_TOKEN=
# npm run dev:local uses your own capped OpenRouter key instead.
OPENROUTER_API_KEY=
# Choose an explicit model ID available to your OpenRouter account.
OPENROUTER_MODEL=
# Optional: LOCAL_WORKDIR=.local
# Optional: PORT=8080
